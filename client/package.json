{
  "name": "k-client",
  "private": true,
  "version": "0.2.27",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-css-compat.mjs",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "//": "原生端已由 android/（Kotlin）独立承担，client 不再携带任何 Capacitor 依赖：网页只经 client/src/lib/native 的自研桥访问原生能力。",
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@k/shared": "file:../shared",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.16.1",
    "libheif-js": "^1.19.8",
    "lucide-react": "^0.511.0",
    "mitt": "^3.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.6.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.0.12",
    "vitest": "^5.0.0"
  }
}
