<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext traffic for API requests（App 实际经 .env.production 的
         VITE_SERVER_URL 走 https://www.kuangdada.top；明文白名单仅为历史兼容保留，
         生产 IP 不写入公开仓库） -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">www.kuangdada.top</domain>
        <domain includeSubdomains="false">kuangdada.top</domain>
    </domain-config>
</network-security-config>
