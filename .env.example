# 霜晨月 环境变量配置示例
# 复制此文件为 .env 并填入你的配置

# 运行环境: production | development（生产环境必须设置）
NODE_ENV=development

# 服务器端口
PORT=3000

# JWT 密钥（生产环境必须修改为强密钥，缺失时拒绝启动）
JWT_SECRET=your-secret-key-here

# 管理员邮箱
ADMIN_EMAIL=your-email@example.com

# CORS 白名单（逗号分隔，生产环境必须包含你的前端域名）
# 原生 App 和同源请求不受影响
ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.com

# 邮件 SMTP 配置（用于发送验证码，QQ邮箱示例）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-email@qq.com
SMTP_PASS=your-smtp-auth-code

# Android 构建时需要用到的服务器地址（生产环境）
# 构建 Android APK 前设置: set VITE_SERVER_URL=http://你的服务器IP:3000
# 本地 Web 开发不需要此项（Vite 代理自动处理）
# VITE_SERVER_URL=http://your-server.com:3000
