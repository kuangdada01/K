# K 环境变量配置示例
# 复制此文件为 .env 并填入你的配置：cp .env.example .env
# 注意：.env 含敏感信息（JWT 密钥/SMTP 密码/TURN 凭证），已被 .gitignore 排除，勿提交

# 运行环境: development | production | test（默认 development）
# 生产部署时由 PM2 的 server/ecosystem.config.js 注入 production，.env 可不写
NODE_ENV=development

# 服务器端口
PORT=3000

# JWT 密钥（生产环境必须修改为强密钥，缺失时拒绝启动）
JWT_SECRET=your-secret-key-here

# CORS 白名单（逗号分隔的跨域来源，同源请求无需配置）
# http://localhost / https://localhost 是 Capacitor 原生 App 的 WebView 来源（SSE 需要）
ALLOWED_ORIGINS=http://localhost:5173,http://localhost,https://localhost,https://your-domain.com

# 管理员邮箱（注册该邮箱后自动成为管理员）
ADMIN_EMAIL=your-email@example.com

# 邮件 SMTP 配置（用于发送验证码，QQ邮箱示例）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-email@qq.com
SMTP_PASS=your-smtp-auth-code

# 服务器前面有 nginx 反代时置为 1：访客 IP 从 x-forwarded-for 读取；
# 未配置则只信任 TCP 对端地址（直连场景防客户端伪造）
# TRUST_PROXY=1

# ffmpeg/ffprobe 可执行文件路径（可选；默认取 PATH 中的 ffmpeg/ffprobe）
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# 语音房间 TURN 中继（可选；默认仅 STUN，P2P 打不通时再配）
# 自建 coturn：阿里云安全组需放行 3478/tcp+udp 与 49160-49200/udp
# VOICE_TURN_URL=turn:your-server:3478
# VOICE_TURN_USERNAME=kvoice
# VOICE_TURN_CREDENTIAL=your-turn-credential

# App 更新检测：配置后 /api/app/version 返回最新版本信息（未配置则视为无更新）
# APP_VERSION=0.0.0
# APP_APK_URL=https://your-domain.com/apk/k-app-0.0.0-release.apk
# APP_UPDATE_NOTES=更新说明

# Android 构建时需要用到的服务器地址（生产环境，写入 client/.env.production）
# 构建 Android APK 前设置: set VITE_SERVER_URL=http://你的服务器IP:3000
# 本地 Web 开发不需要此项（Vite 代理自动处理）
# VITE_SERVER_URL=http://your-server.com:3000
